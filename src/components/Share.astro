---
import { SITE } from '../site.config';

interface Props {
  title?: string;
  url?: string;
}

const { title, url = '' } = Astro.props;
const permalink = new URL(url, SITE.url).href;
const intentText = `${title || SITE.title} | ${SITE.title} ${permalink}`;
const tweetUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(intentText + ' #ut_wow #wowjp')}`;
---
<a href={tweetUrl} class="btn btn-default" title="Tweet!" target="_blank">
  <i class="fab fa-fw fa-twitter" aria-hidden="true"></i><span>Tweet!</span>
</a>
<div class="align-right">
  <a href={permalink}><small>{permalink}</small></a>
</div>
