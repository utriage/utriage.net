---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../site.config';
import { getPostSlug, getPostTags, getPostDate } from '../utils/posts';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => getPostDate(b).getTime() - getPostDate(a).getTime());

// Group posts by tag
const tagMap = new Map<string, Array<{ url: string; title: string }>>();
for (const post of sortedPosts) {
  const tags = getPostTags(post);
  const url = `/${getPostSlug(post)}`;
  for (const tag of tags) {
    if (!tagMap.has(tag)) {
      tagMap.set(tag, []);
    }
    tagMap.get(tag)!.push({ url, title: post.data.title });
  }
}

// Sort tag names alphabetically
const sortedTags = Array.from(tagMap.keys()).sort((a, b) => a.localeCompare(b));
---
<BaseLayout title="アーカイブ" excerpt="タグ別記事アーカイブ" url="/tags" bodyId="posts" bodyClass="inner-post-page">
  <div class="block-left">
    <div class="content">
      <a href="/" class="logo"><img src={`/images/${SITE.logo}`} alt={SITE.title} /></a>
      <div class="post-title-section">
        <div class="section-line">
          <a href="/">Back to home</a> <em>/</em>
        </div>
        <h1 class="section-title">アーカイブ</h1>
        <div class="section-line reverse">Ultimate Triage <em>/</em></div>
      </div>
    </div>
  </div>

  <div class="block-right">
    <Navigation />
    <div class="inner-post content">
      <ul class="entry-meta">
        {sortedTags.map((tag) => (
          <li>
            <a href={`#${tag}`} class="tag">
              <span class="term">{tag}</span>
              <span class="count">{tagMap.get(tag)!.length}</span>
            </a>
          </li>
        ))}
      </ul>

      {sortedTags.map((tag) => (
        <div>
          <h2 id={tag} class="tag-heading">{tag}</h2>
          <ul>
            {tagMap.get(tag)!.map((post) => (
              <li class="entry-title">
                <a href={post.url} title={post.title}>{post.title}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
